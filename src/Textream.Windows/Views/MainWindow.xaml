<Window x:Class="Textream.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Textream.Windows.ViewModels"
        mc:Ignorable="d"
        Title="Textream" Height="640" Width="960"
        MinHeight="400" MinWidth="600"
        Background="#18181B"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding TogglePrompterCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding AddPageCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding OpenSettingsCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Standard Toolbar Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2E2E35"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1A1A1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Toolbar Button (+ Add Page) -->
        <Style x:Key="ToolbarAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#064E3B"/>
            <Setter Property="Foreground" Value="#6EE7B7"/>
            <Setter Property="BorderBrush" Value="#059669"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="accentBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="accentBorder" Property="Background" Value="#047857"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Action Button -->
        <Style x:Key="SidebarActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="sideBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sideBorder" Property="Background" Value="#2E2E35"/>
                                <Setter TargetName="sideBorder" Property="BorderBrush" Value="#6366F1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar / Header -->
            <RowDefinition Height="*"/>    <!-- Content Split -->
            <RowDefinition Height="Auto"/> <!-- Status / Footer -->
        </Grid.RowDefinitions>

        <!-- Top Header & Toolbar -->
        <Border Grid.Row="0" Background="#121215" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Document Title & Dirty Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Textream" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Border Background="#202024" BorderBrush="#333338" BorderThickness="1" CornerRadius="5" Padding="10,4" VerticalAlignment="Center" MaxWidth="180">
                        <StackPanel Orientation="Horizontal">
                            <!-- Unsaved changes orange dot -->
                            <Ellipse Width="7" Height="7" Fill="#F97316" Margin="0,0,6,0"
                                     Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding DocumentTitle}" FontSize="12" FontWeight="Medium" Foreground="#E4E4E7" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Actions: responsive WrapPanel preventing overlap on smaller screens -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📄  New" Command="{Binding NewCommand}" ToolTip="New Script (Ctrl+N)" Style="{StaticResource ToolbarButtonStyle}" Margin="0,2,6,2"/>
                    <Button Content="📂  Open..." Command="{Binding OpenCommand}" ToolTip="Open Presentation or Script (Ctrl+O)" Style="{StaticResource ToolbarButtonStyle}" Margin="0,2,6,2"/>
                    <Button Content="💾  Save" Command="{Binding SaveCommand}" ToolTip="Save Script (Ctrl+S)" Style="{StaticResource ToolbarButtonStyle}" Margin="0,2,6,2"/>
                    <Button Content="➕  Add Page" Command="{Binding AddPageCommand}" ToolTip="Add Page (Ctrl+T)" Style="{StaticResource ToolbarAccentButtonStyle}" Margin="0,2,10,2"/>

                    <Border Background="#202024" BorderBrush="#333338" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,2,6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ListeningModeLabel}" FontSize="11" FontWeight="Medium" Foreground="#A1A1AA"/>
                    </Border>
                    <Button Content="⚙  Settings" Command="{Binding OpenSettingsCommand}" ToolTip="Preferences (Ctrl+,)" Style="{StaticResource ToolbarButtonStyle}" Margin="0,2,6,2"/>
                    <Button Content="ℹ  About" Command="{Binding OpenAboutCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,2,0,2"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Main Body: Split View -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" MaxWidth="320"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: Page List -->
            <Grid Grid.Column="0" Background="#18181B">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="PAGES" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="16,14,16,8"/>

                <ListBox Grid.Row="1" ItemsSource="{Binding PageList}" SelectedIndex="{Binding SelectedPageIndex}"
                         Background="Transparent" BorderThickness="0" Margin="8,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Name="Border" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="8,6">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#222226"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#333338"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#2E2E36"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#6366F1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Page number badge -->
                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4"
                                        Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Index, StringFormat={}{0}}" FontSize="11" FontWeight="Bold"
                                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Preview text snippet -->
                                <TextBlock Grid.Column="1" Text="{Binding Preview}" FontSize="12" Foreground="#E4E4E7"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Delete Page" Command="{Binding DeletePageCommand}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <!-- Full-width sidebar add button -->
                <Button Grid.Row="2" Content="➕  Add New Page" Command="{Binding AddPageCommand}"
                        Style="{StaticResource SidebarActionButtonStyle}" Margin="12,10,12,12"/>
            </Grid>

            <!-- Column Splitter Line -->
            <GridSplitter Grid.Column="1" Width="1" Background="#27272A" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Main Editor Area -->
            <Grid Grid.Column="2" Background="#121214">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Language Suggestion Banner (ED-03) -->
                <Border Grid.Row="0"
                        Background="#2A2415"
                        BorderBrush="#E5A93C"
                        BorderThickness="0,0,0,1"
                        Padding="16,8"
                        Visibility="{Binding HasLanguageSuggestion, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐 Script appears to be in " Foreground="#E5A93C" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding LanguageSuggestion.LanguageName}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text=". Switch speech recognition language?" Foreground="#E5A93C" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Switch Language"
                                Command="{Binding SwitchLanguageCommand}"
                                Background="#E5A93C"
                                Foreground="#18181B"
                                FontWeight="Bold"
                                FontSize="12"
                                Padding="12,5"
                                Margin="12,0,8,0"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2"
                                Content="✕"
                                Command="{Binding DismissLanguageCommand}"
                                Background="Transparent"
                                Foreground="#A1A1AA"
                                FontSize="12"
                                Padding="6,4"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Script Editor -->
                <TextBox Grid.Row="1"
                         Text="{Binding CurrentPageText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         Foreground="#FAFAFA"
                         CaretBrush="#FFFFFF"
                         BorderThickness="0"
                         FontSize="16"
                         FontFamily="Segoe UI"
                         Padding="30,24,30,100"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"/>

                <!-- Bottom Floating Control Pill (Prompter & Dictation) -->
                <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,28,28" Background="#1E1E24" CornerRadius="12" Padding="8,6"
                        BorderBrush="#3F3F4E" BorderThickness="1.5">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.55"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Dictation / Mic Button with explicit label -->
                        <Button Command="{Binding ToggleDictationCommand}"
                                ToolTip="Toggle Speech Dictation (speech-to-text)" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8"
                                            Background="{Binding DictationButtonBackground}"
                                            BorderBrush="{Binding DictationButtonBorder}"
                                            BorderThickness="1"
                                            Padding="14,10">
                                        <TextBlock Text="{Binding DictationButtonLabel}"
                                                   Foreground="#F4F4F5"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Primary Teleprompter Action Button -->
                        <Button Command="{Binding TogglePrompterCommand}"
                                ToolTip="Launch Overlay Teleprompter (Ctrl+Return)" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8"
                                            Background="{Binding PrompterButtonBackground}"
                                            BorderBrush="{Binding PrompterButtonBorder}"
                                            BorderThickness="1.5"
                                            Padding="20,10">
                                        <TextBlock Text="{Binding PrompterButtonLabel}"
                                                   Foreground="#FFFFFF"
                                                   FontWeight="Bold"
                                                   FontSize="14"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#121214" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" Foreground="#A1A1AA"/>
                <TextBlock Grid.Column="1" Text="Shortcuts: Ctrl+Return = Prompter | Ctrl+N = New | Ctrl+O = Open | Ctrl+S = Save" FontSize="11" Foreground="#71717A"/>
            </Grid>
        </Border>
    </Grid>
</Window>
