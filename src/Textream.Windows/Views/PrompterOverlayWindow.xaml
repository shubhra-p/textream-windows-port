<Window x:Class="Textream.Windows.Views.PrompterOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Textream Teleprompter"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <!-- Overlay Navigation Button Style -->
        <Style x:Key="OverlayNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#66FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#AAFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Overlay Close Button Style -->
        <Style x:Key="OverlayCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#33EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#66EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#F87171"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Main Teleprompter Container -->
        <Border x:Name="OverlayBorder"
                Background="#F0121217"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="0,0,22,22">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.6"/>
            </Border.Effect>

            <Grid Margin="12,8,12,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Bar / Controls -->
                    <RowDefinition Height="*"/>    <!-- Text Area / Words -->
                    <RowDefinition Height="Auto"/> <!-- Next Page Countdown Banner -->
                    <RowDefinition Height="14"/>   <!-- Waveform Visualizer -->
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Grid Grid.Row="0" Margin="4,2,4,6" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Page Info & Navigation -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PrevPageButton" Content="◀" Width="30" Height="24"
                                ToolTip="Previous Page (PgUp)" Style="{StaticResource OverlayNavButtonStyle}"
                                Click="OnPrevPageClick" Margin="0,0,6,0"/>
                        <Border Background="#25FFFFFF" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PageBadgeText" Text="1 / 1"
                                       Foreground="#E4E4E7" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="NextPageButton" Content="▶" Width="30" Height="24"
                                ToolTip="Next Page (PgDn)" Style="{StaticResource OverlayNavButtonStyle}"
                                Click="OnNextPageClick" Margin="0,0,8,0"/>
                    </StackPanel>

                    <!-- Center: Drag Handle (in Floating mode) or Mode indicator -->
                    <StackPanel x:Name="DragHandlePanel" Grid.Column="1" HorizontalAlignment="Center"
                                Orientation="Horizontal" Cursor="SizeAll" MouseLeftButtonDown="OnDragHandleMouseDown">
                        <Border Width="40" Height="5" Background="#44FFFFFF" CornerRadius="2.5" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Close Button & Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,3" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusBadge" Text="TRACKING" Foreground="#4CD964"
                                       FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>
                        <Button Content="✕" Width="28" Height="24"
                                ToolTip="Exit Prompter (Esc)" Style="{StaticResource OverlayCloseButtonStyle}"
                                Click="OnCloseClick"/>
                    </StackPanel>
                </Grid>

                <!-- Words Scroll Area -->
                <ScrollViewer x:Name="TextScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                    <WrapPanel x:Name="WordsWrapPanel"
                               Orientation="Horizontal"
                               Margin="6,8,6,12"
                               HorizontalAlignment="Center"/>
                </ScrollViewer>

                <!-- Next Page Banner -->
                <Border x:Name="NextPageBanner"
                        Grid.Row="2"
                        Background="#E00A84FF"
                        CornerRadius="8"
                        Padding="12,5"
                        Margin="4,2,4,4"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center">
                    <TextBlock x:Name="NextPageBannerText"
                               Text="Next page in 2s..."
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>

                <!-- Bottom Waveform Audio Visualizer -->
                <Canvas x:Name="VisualizerCanvas"
                        Grid.Row="3"
                        Height="14"
                        Margin="4,2,4,0"
                        HorizontalAlignment="Stretch"
                        ClipToBounds="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
