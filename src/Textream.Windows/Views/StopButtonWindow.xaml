<Window x:Class="Textream.Windows.Views.StopButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Textream Stop"
        Width="140" Height="48"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Background="#EE1E1E22"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            CornerRadius="24"
            Padding="12,6"
            Cursor="Hand"
            MouseLeftButtonDown="OnStopClick">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="14" Height="14" Background="#FFFF453A" CornerRadius="2" Margin="0,0,8,0"/>
            <TextBlock Text="Stop (Esc)" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
