<Window x:Class="Textream.Windows.Views.ExternalPrompterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Textream External Projection"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Grid x:Name="TransformHostGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="MirrorTransform" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <ScrollViewer x:Name="TextScrollViewer"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <WrapPanel x:Name="WordsWrapPanel"
                       Orientation="Horizontal"
                       Margin="48,80,48,80"
                       HorizontalAlignment="Center"/>
        </ScrollViewer>
    </Grid>
</Window>
